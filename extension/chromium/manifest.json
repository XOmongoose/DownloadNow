{
  "manifest_version": 3,
  "name": "Download Now Bridge",
  "version": "1.8.2",
  "description": "Gửi liên kết tải HTTP(S) tới Download Now trên máy của bạn.",
  "permissions": [
    "storage",
    "contextMenus",
    "downloads",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Download Now"
  },
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
